# Telegram is optional. When it is enabled, limit access to your own numeric user ID.
# ALLOWED_USER_ID is mandatory whenever TELEGRAM_BOT_TOKEN is set.
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_ID=

# Apple Intelligence bridge defaults. Override only when using another
# OpenAI-compatible local server.
LLM_BASE_URL=http://127.0.0.1:1976/v1
LOCAL_MODEL=system
PCC_MODEL=pcc
# hybrid (AFM for simple, PCC for complex), local (AFM only), pcc (PCC only)
# or cloud (external OpenAI-compatible provider, see CLOUD_* below).
MODEL_MODE=hybrid
# Seconds before a model request is aborted.
LLM_TIMEOUT=120

# Cloud provider for MODEL_MODE=cloud. Any OpenAI-compatible endpoint works,
# e.g. Alibaba DashScope: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
CLOUD_BASE_URL=
CLOUD_API_KEY=
CLOUD_MODEL=
CLOUD_PROMPT_PROFILE=full
CLOUD_CONTEXT_TOKEN_BUDGET=12000

# Voice message transcription (Telegram voice -> text). Falls back to
# CLOUD_BASE_URL / CLOUD_API_KEY when STT_* are empty; empty STT_API_KEY with
# no CLOUD_API_KEY disables voice input. Groq: whisper-large-v3-turbo.
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo

# Prompt profiles: mini or full. PROMPT_PROFILE forces both models.
PROMPT_PROFILE=
LOCAL_PROMPT_PROFILE=mini
PCC_PROMPT_PROFILE=full

# Context budgets (estimated tokens) and compaction.
LOCAL_CONTEXT_TOKEN_BUDGET=3000
PCC_CONTEXT_TOKEN_BUDGET=12000
COMPACT_TRIGGER_RATIO=0.8
COMPACT_KEEP_MESSAGES=10
MAX_TOOL_OUTPUT=2000

# Web search: auto, quick, normal or deep (forced depth for every call).
WEB_SEARCH_FORCE_DEPTH=auto

# Per-request run budget.
RUN_MAX_STEPS=8
RUN_MAX_MODEL_CALLS=12
RUN_MAX_TOOL_CALLS=12
RUN_MAX_SECONDS=180
RUN_MAX_TOOL_OUTPUT_CHARS=2000
RUN_MAX_CONSECUTIVE_ERRORS=3
RUN_MAX_IDENTICAL_CALLS=2

# Safe bash: commands run inside BASH_WORKSPACE; writes outside are denied.
# BASH_APPROVAL: deny (default) or prompt (ask in CLI before destructive runs).
BASH_WORKSPACE=.
BASH_TIMEOUT=30
BASH_OUTPUT_LIMIT=4000
BASH_APPROVAL=deny
ALLOW_DESTRUCTIVE=false

# Scheduler / state.
JOBS_FILE=jobs.json
LOG_DIR=logs
